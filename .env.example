# Copy to `.env.local` and fill in values.
# Base Xano API group: https://x8ki-letl-twmt.n7.xano.io/api:pVi32Dp4/

# --- Clerk (required) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- Xano: catalog & variants ---
# Optional: server routes fall back to hardcoded default when unset.
XANO_PRODUCTS_URL=
# Optional: derived from XANO_PRODUCTS_URL (/products -> /variants) when unset.
XANO_LIST_VARIANTS_URL=
# Required for GET /api/lookbooks (no default in that route).
XANO_LOOKBOOKS_URL=

# --- Xano: admin import / publish ---
# Required for POST /api/import-product
XANO_IMPORT_PRODUCT_URL=
XANO_CREATE_VARIANT_URL=
# Required for POST /api/draft-products
XANO_DRAFT_PRODUCTS_URL=
# Required for POST /api/publish-product
XANO_PUBLISH_PRODUCT_URL=

# --- Xano: product / lookbook updates (server API routes) ---
# Optional: each route has a hardcoded DEFAULT_* fallback when unset.
XANO_UPDATE_PRODUCT_GENDER_URL=
XANO_UPDATE_PRODUCT_SIZE_TABLE_URL=
XANO_UPDATE_PRODUCT_FAVORITE_COUNT_URL=
XANO_UPDATE_LOOKBOOK_FAVORITE_COUNT_URL=

# --- Xano: stock sync & monitor ---
# Used by /api/admin-sync-product-stock (optional defaults) and /api/stock-monitor/check (required there).
XANO_UPDATE_VARIANT_STOCK_URL=
XANO_UPDATE_PRODUCT_STOCK_URL=
# Required for /api/stock-monitor and /api/stock-monitor/check
XANO_STOCK_MONITOR_PRODUCTS_URL=
# Required for /api/stock-monitor/check
XANO_CREATE_STOCK_CHECK_URL=

# --- Xano: orders (server admin route) ---
# Required for POST /api/admin/orders/shipping
XANO_UPDATE_ORDER_SHIPPING_URL=
# Optional: POST /api/validate-coupon uses hardcoded default when unset.
XANO_VALIDATE_COUPON_URL=

# --- Xano: settings & rankings ---
# Optional: import pricing uses 0.25 x 1.35 when unset (lib/products/sync-product-price.ts).
XANO_SETTINGS_URL=
# Optional: lib/rankings/xano-sales-rankings.ts has hardcoded default.
XANO_SALES_RANKINGS_URL=

# --- Not process.env (hardcoded in components/JGoApp.tsx) ---
# Documented for reference only; changing these requires code changes today.
# XANO_CHECKOUT_URL              -> checkout
# XANO_ADD_ORDER_ITEM_URL        -> add-order-item
# XANO_GET_ORDERS_URL             -> Get_Orders
# XANO_GET_ORDER_ITEMS_URL        -> order-items
# XANO_CREATE_ECPAY_ORDER_URL     -> create-ecpay-order
# XANO_CREATE_CVS_MAP_URL         -> create-cvs-map
# XANO_DECREASE_STOCK_URL         -> decrease-stock
# XANO_UPDATE_ORDER_SHIPPING_STATUS_URL -> update-order-shipping-status
# XANO_ADMIN_ORDERS_URL           -> admin-orders
# XANO_ADMIN_CREATE_PRODUCT_URL   -> admin-create-product
# XANO_ADMIN_UPDATE_PRODUCT_URL   -> admin-update-product
# XANO_ADMIN_DELETE_PRODUCT_URL   -> admin-delete-product
# XANO_RECALCULATE_PRODUCTS_URL   -> admin-recalculate-all-products
# Client lookbook CRUD also uses hardcoded XANO_LOOKBOOKS_URL constant (same endpoint as env above).

# --- Not process.env (Next.js route, not a Xano URL env) ---
# Admin stock sync is POST /api/admin-sync-product-stock (uses XANO_* stock URLs above).
# There is no XANO_ADMIN_SYNC_PRODUCT_STOCK_URL in this repo.

# --- Vercel Blob (required for POST /api/admin/upload-lookbook-image) ---
BLOB_READ_WRITE_TOKEN=

# --- OpenAI (optional: product import translation, AI support) ---
OPENAI_API_KEY=

# --- Google Analytics (optional) ---
NEXT_PUBLIC_GA_MEASUREMENT_ID=
