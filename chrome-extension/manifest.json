{
  "manifest_version": 3,
  "name": "J-GO ZOZO Importer",
  "version": "1.2.1",
  "description": "Import and sync ZOZOTOWN product stock into J-GO",
  "permissions": ["storage", "tabs"],
  "host_permissions": [
    "https://zozo.jp/*",
    "https://*.zozo.jp/*",
    "http://localhost:3000/*",
    "https://j-go-xd5a.vercel.app/*",
    "https://*.vercel.app/*"
  ],
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://zozo.jp/shop/*/goods/*",
        "https://zozo.jp/shop/*/goods-sale/*",
        "https://*.zozo.jp/shop/*/goods/*",
        "https://*.zozo.jp/shop/*/goods-sale/*"
      ],
      "js": ["dist/content.js"],
      "css": ["dist/content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://localhost:3000/admin/stock-monitor*",
        "https://j-go-xd5a.vercel.app/admin/stock-monitor*",
        "https://*.vercel.app/admin/stock-monitor*"
      ],
      "js": ["dist/admin-bridge.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "action": {
    "default_title": "J-GO Importer",
    "default_popup": "popup.html"
  }
}
